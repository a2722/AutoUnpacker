# ===== 用户本地数据（隐私，绝不提交） =====
# 用户配置：推送更新时不会覆盖本地 config.json
config.json
# 临时密码（含剪贴板捕获的密码/路径）
temp_passwords.json
# 长期密码本数据库
toolbox.db
# SQLite 随身文件：WAL/SHM/journal 里是同样的明文数据，运行时随时出现
toolbox.db-*
*.db-wal
*.db-shm
*.db-journal
# 删除回溯记录（含真实文件路径）
deletion_trail.json
# 挂起的网址信任询问（含用户访问过的网址/域名）
pending_trust.json
# 运行日志（含明文密码和文件路径）
logs/
# 崩溃日志（含用户路径，含轮转出来的 crash.log.1 等）
crash.log*
# 其他散落日志（含轮转文件）
*.log

# ===== 历史备份（含敏感数据副本） =====
backup/

# ===== 本地排查/笔记文件 =====
新建文件夹/
# UI 风格方案稿（本地草稿，不公开）
ui-proposals/

# ===== 内部维护笔记（AI/维护者专用，不公开） =====
.omo/

# ===== 交付物里的「内部交流」材料（只在我们之间流转，绝不入库） =====
# 图标/素材包常带交付说明、设计稿说明等，属内部交流文档，不是源码。
# 放进 assets/ 的只允许成品资源（.ico/.png/.svg 等）+ 代码引用。
autounpacker/assets/*.txt
autounpacker/assets/*.md
autounpacker/assets/README*

# ===== Python 缓存 =====
__pycache__/
*.pyc
*.pyo
# 工具缓存目录（ruff 会自建 .ruff_cache/.gitignore，这里再兜一层）
.ruff_cache/
.pytest_cache/
.mypy_cache/

# ===== 打包 / 虚拟环境产物（源码仓库不收录）=====
build/
dist/
venv/
.venv/
# 发版资产（冻结更新包 / 便携包）由 make_release_asset.py 生成后**只上传 Release**，
# 绝不入库（历史上仓库从未跟踪任何 .zip）。dist/ 已在上方忽略，这里兜住根目录那份。
/AutoUnpacker-*.zip

# ===== 第三方二进制 =====
*.dll
*.exe

# ===== 运行时临时目录 =====
.stage_*/
ExtractTemp/
*.tmp
# 运行时生成的缓存（如主题图标：下拉箭头 / 选中对勾 / 单选圆点）
cache/

# ===== 编辑器/系统文件 =====
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/